# ------------------------------------------------------------------
# SadhyamIAS Android app — configuration
# Change these values and restart `npx expo start` (or rebuild with EAS).
# Every EXPO_PUBLIC_ value is bundled into the app, so never put secrets here.
# ------------------------------------------------------------------

# Your website. The app calls its APIs (tests, library, results, PDFs),
# loads relative images from it, and opens it in the browser for payments.
# No trailing slash.
EXPO_PUBLIC_WEBSITE_URL=https://www.sadhyamias.com

# App name shown in the launch animation and headers
EXPO_PUBLIC_APP_NAME=SadhyamIAS
EXPO_PUBLIC_APP_TAGLINE=Prepare. Practice. Perform.

# How purchases behave in the app (Google Play policy):
#   external = tapping Buy / Enroll / Pay shows a dialog and opens your website in the system browser
#   none     = purchase buttons only say the item can't be bought in the app (no link out)
EXPO_PUBLIC_PURCHASE_MODE=external

# Firebase web app config (same project as the website: Firebase console → Project settings → Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyBelwML4iaDP9TEJSWMgcMQuevZlkq2IQo
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=sadhyam-20d5a.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=sadhyam-20d5a
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=sadhyam-20d5a.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=991970340826
EXPO_PUBLIC_FIREBASE_APP_ID=1:991970340826:web:59967479a40db900459ae3

# Google sign-in (native Android account picker → Firebase Auth, same as the website).
# Firebase console → Authentication → Sign-in method → Google → "Web SDK configuration" → Web client ID
# (looks like 991970340826-xxxxxxxx.apps.googleusercontent.com). Leave empty to hide the Google button.
# Also add your app's SHA-1 fingerprint(s) to the Android app in Firebase (see README).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=991970340826-a3p2ktee56fo0g2hfvli61fhddrkp732.apps.googleusercontent.com

# Android application id (used by app.config.ts at build time — change before your first Play upload)
ANDROID_PACKAGE=com.sadhyamias.app
